# Docker: use the mounted JSON configuration.
# Leave CONFIG_FILE empty to use the single-account connection variables below.
CONFIG_FILE=/app/config.json

# Start with a manual dry run; set a cron expression to enable scheduled runs.
SKIP_INITIAL_RUN=true
CRON_SCHEDULE=

# Single-account mode only (CONFIG_FILE must be empty).
IMMICH_URL=
IMMICH_KEY=
CARDDAV_URL=
CARDDAV_USERNAME=
CARDDAV_PASSWORD=
# Example only: adapt the address book path to your CardDAV server.
# Single quotes preserve the placeholder for expansion by the bridge.
CARDDAV_PATH_TEMPLATE='/addressbooks/$CARDDAV_USERNAME/'
CARDDAV_ADDRESSBOOKS=

# Defaults only: explicit settings in config.json take precedence.
# Supported birthday modes: off, bidirectional, carddav-to-immich.
BIRTHDAY_SYNC=off
BIRTHDAY_STATE_FILE=.bridge-state/birthdays.json
SKIP_PHOTOS=false
